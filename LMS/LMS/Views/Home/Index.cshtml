@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Meal Planner - Gợi ý nấu ăn gia đình</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background: #f8f9fa;
            }

            .hero {
                background: url('https://images.unsplash.com/photo-1504674900247-0877df9cc836') center/cover;
                height: 300px;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
            }

                .hero h1 {
                    background: rgba(0,0,0,0.5);
                    padding: 15px;
                    border-radius: 10px;
                }

            .card:hover {
                transform: scale(1.03);
                transition: 0.3s;
            }

            .footer {
                background: #343a40;
                color: white;
                padding: 20px;
                margin-top: 40px;
                text-align: center;
            }
    </style>
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="#">🍲 Meal Planner</a>

            <div class="collapse navbar-collapse">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item"><a class="nav-link" href="#">Trang chủ</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Món ăn</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Thực đơn</a></li>
                    <li class="nav-item"><a class="nav-link" href="#">Đăng nhập</a></li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- HERO -->
    <div class="hero">
        <div>
            <h1>Gợi ý món ăn & Lập thực đơn cho gia đình</h1>
            <p>Tìm món ngon mỗi ngày - dễ nấu - tiết kiệm thời gian</p>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="container mt-4">
        <div class="row">
            <div class="col-md-8 offset-md-2">
                <input class="form-control" placeholder="Tìm món ăn..." />
            </div>
        </div>
    </div>

    <!-- CATEGORY -->
    <div class="container mt-4">
        <h4>Danh mục món ăn</h4>

        <div class="row">
            <div class="col-md-3">
                <div class="card p-3 text-center">🍜 Món nước</div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center">🍗 Món mặn</div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center">🥗 Ăn chay</div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center">🍰 Tráng miệng</div>
            </div>
        </div>
    </div>

    <!-- SUGGESTIONS -->
    <div class="container mt-5">
        <h4>Món ăn gợi ý hôm nay</h4>

        <div class="row">
            <div class="col-md-4">
                <div class="card">
                    <img src="https://source.unsplash.com/400x250/?food" />
                    <div class="card-body">
                        <h5>Canh chua cá</h5>
                        <p>Dễ nấu - 30 phút</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <img src="https://source.unsplash.com/400x250/?noodles" />
                    <div class="card-body">
                        <h5>Bún bò Huế</h5>
                        <p>Đậm đà - truyền thống</p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card">
                    <img src="https://source.unsplash.com/400x250/?rice" />
                    <div class="card-body">
                        <h5>Cơm gà</h5>
                        <p>Nhanh - tiện - ngon</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <div class="footer">
        <p>© 2026 Meal Planner - Gợi ý nấu ăn cho gia đình</p>
    </div>

</body>
</html>