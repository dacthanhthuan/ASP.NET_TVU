@{
    Layout = null;
}
@using Microsoft.AspNetCore.Http

@{
    var fullname = Context.Session.GetString("Fullname");
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Meal Planner - Gợi ý nấu ăn gia đình</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background: #f8f9fa;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            .content {
                flex: 1;
            }

            /* HERO */
            .hero {
                background: url('https://images.unsplash.com/photo-1504674900247-0877df9cc836') center/cover;
                height: 300px;
                color: white;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
            }

                .hero h1 {
                    background: rgba(0,0,0,0.5);
                    padding: 15px 25px;
                    border-radius: 10px;
                }

            /* SECTION */
            .search-section{
                margin-top: 15px;
            }
            .category-section{
                margin-top: 20px;
            }
            .suggestion-section {
                margin-top: 25px;
            }

            /* CARD */
            .card {
                height: 100%;
                border: none;
                border-radius: 10px;
                overflow: hidden;
                box-shadow: 0 2px 8px rgba(0,0,0,.08);
                transition: all .3s ease;
            }

                .card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 5px 15px rgba(0,0,0,.15);
                }

                .card img {
                    width: 100%;
                    height: 200px;
                    object-fit: cover;
                }

            .card-body {
                text-align: center;
            }

                .card-body h5 {
                    margin-bottom: 10px;
                    font-weight: 600;
                }

                .card-body p {
                    color: #6c757d;
                    margin-bottom: 0;
                }

            /* CATEGORY CARD */
            .category-section .card {
                cursor: pointer;
                font-weight: 600;
            }

            /* FOOTER */
            .footer {
                background: #343a40;
                color: white;
                text-align: center;
                padding: 10px;
            }

                .footer p {
                    margin: 0;
                }
    </style>
</head>

<body>

    <div class="content">

        <!-- NAVBAR -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm fixed-top">
            <div class="container">

                <a class="navbar-brand fw-bold" href="#">
                    🍲 Meal Planner
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMenu">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarMenu">
                    <ul class="navbar-nav ms-auto align-items-lg-center">

                        <li class="nav-item">
                            <a class="nav-link active" href="#">
                                🏠 Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                🍲 Món ăn
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link" href="#">
                                📅 Thực đơn
                            </a>
                        </li>

                        @if (!string.IsNullOrEmpty(fullname))
                        {
                            <li class="nav-item dropdown ms-lg-3">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    👋 @fullname
                                </a>

                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <span class="dropdown-item-text">
                                            @Context.Session.GetString("Phone")
                                        </span>
                                    </li>

                                    <li><hr class="dropdown-divider"></li>

                                    <li>
                                        <a class="dropdown-item"
                                           href="/Account/Logout">
                                            🚪 Đăng xuất
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-outline-light btn-sm"
                                   href="/Account/Login">
                                    🔑 Đăng nhập
                                </a>
                            </li>
                        }

                    </ul>
                </div>

            </div>
        </nav>

        <!-- HERO -->
        <div class="hero">
            <div>
                <h1>Gợi ý món ăn & Lập thực đơn cho gia đình</h1>
                <p class="mt-3">
                    Tìm món ngon mỗi ngày - dễ nấu - tiết kiệm thời gian
                </p>
            </div>
        </div>

        <!-- SEARCH -->
        <div class="container search-section">
            <div class="row">
                <div class="col-lg-6 col-md-8 mx-auto">
                    <input class="form-control form-control-lg"
                           placeholder="🔍 Tìm món ăn..." />
                </div>
            </div>
        </div>

        <!-- CATEGORY -->
        <div class="container category-section">

            <h3 class="mb-4 text-center">
                Danh mục món ăn
            </h3>

            <div class="row g-4">

                <div class="col-md-3 col-sm-6">
                    <div class="card p-4 text-center">
                        🍜 Món nước
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="card p-4 text-center">
                        🍗 Món mặn
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="card p-4 text-center">
                        🥗 Ăn chay
                    </div>
                </div>

                <div class="col-md-3 col-sm-6">
                    <div class="card p-4 text-center">
                        🍰 Tráng miệng
                    </div>
                </div>

            </div>

        </div>

        <!-- SUGGESTIONS -->
        <div class="container suggestion-section">

            <h3 class="mb-4 text-center">
                Món ăn gợi ý hôm nay
            </h3>

            <div class="row g-4">

                <div class="col-md-4">
                    <div class="card h-100">
                        <img src="./images/img_canhchuaca.webp" alt="Canh chua cá">

                        <div class="card-body">
                            <h5>Canh chua cá</h5>
                            <p>Dễ nấu - 30 phút</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100">
                        <img src="./images/img_bunbo.webp" alt="Bún bò Huế">

                        <div class="card-body">
                            <h5>Bún bò Huế</h5>
                            <p>Đậm đà - truyền thống</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100">
                        <img src="./images/img_comga.jpg" alt="Cơm gà">

                        <div class="card-body">
                            <h5>Cơm gà</h5>
                            <p>Nhanh - tiện - ngon</p>
                        </div>
                    </div>
                </div>

            </div>

        </div>

    </div>

    <!-- FOOTER -->
    <footer class="footer">
        <p>
            © 2026 Meal Planner - Gợi ý nấu ăn cho gia đình
        </p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>

@* Reload trang khi người dùng quay lại bằng nút Back *@
<script>
    window.addEventListener("pageshow", function (event) {
    if (event.persisted ||
    (window.performance &&
    window.performance.navigation.type === 2)) {

    window.location.reload();
    }
    });
</script>