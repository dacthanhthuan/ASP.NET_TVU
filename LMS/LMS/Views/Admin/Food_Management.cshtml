@model LMS.ViewModels.FoodCreateViewModel

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Meal Planner</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background: #f8f9fa;
                padding-top: 70px;
            }

            .card img {
                object-fit: cover;
            }
    </style>
</head>

<body>

    <div class="container">

        <h3 class="mb-4">🍲 Quản lý món ăn</h3>

        <!-- ================= FORM ADD ================= -->
        <form id="foodForm" enctype="multipart/form-data" class="card p-3 shadow-sm">

            <input name="Food.FOOD_NAME" class="form-control mb-2" placeholder="Tên món ăn" />

            <select name="Food.CATEGORY_ID" class="form-select mb-2">
                @foreach (var item in Model.Categories)
                {
                    <option value="@item.CATEGORY_ID">@item.CATEGORY_NAME</option>
                }
            </select>

            <textarea name="Food.DESCRIPTION" class="form-control mb-2" placeholder="Mô tả"></textarea>

            <input type="file" name="ImageFile" class="form-control mb-2" />

            <select name="Food.COOK_TIME" class="form-select mb-2">
                <option value="15">15 phút</option>
                <option value="30">30 phút</option>
                <option value="45">45 phút</option>
            </select>

            <button class="btn btn-success">
                ➕ Thêm món
            </button>

        </form>

        <hr />

        <!-- ================= LIST FOOD ================= -->
        <div class="row" id="foodList">

            @foreach (var item in Model.Foods)
            {
                <div class="col-md-4 mb-3" id="food-@item.FOOD_ID">

                    <div class="card shadow-sm">

                        <img src="@item.IMAGE_URL" class="card-img-top" style="height:180px;" />

                        <div class="card-body">
                            <h5>@item.FOOD_NAME</h5>
                            <p class="desc">@item.DESCRIPTION</p>
                            <p class="cook">⏱ @item.COOK_TIME phút</p>
                        </div>

                        <div class="card-footer text-end">

                            <button class="btn btn-warning btn-sm"
                                    onclick="openEdit(@item.FOOD_ID,
                                '@item.FOOD_NAME',
                                '@item.DESCRIPTION',
                                @item.COOK_TIME,
                                @item.CATEGORY_ID)">
                                ✏ Sửa
                            </button>

                            <button class="btn btn-danger btn-sm"
                                    onclick="deleteFood(@item.FOOD_ID)">
                                🗑 Xoá
                            </button>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

    <!-- ================= EDIT MODAL ================= -->
    <div class="modal fade" id="editModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content p-3">

                <input type="hidden" id="editId" />

                <input id="editName" class="form-control mb-2" placeholder="Tên món" />

                <select id="editCategory" class="form-select mb-2">
                    @foreach (var item in Model.Categories)
                    {
                        <option value="@item.CATEGORY_ID">@item.CATEGORY_NAME</option>
                    }
                </select>

                <textarea id="editDesc" class="form-control mb-2"></textarea>

                <select id="editCook" class="form-select mb-2">
                    <option value="15">15 phút</option>
                    <option value="30">30 phút</option>
                    <option value="45">45 phút</option>
                </select>

                <input type="file" id="editImage" class="form-control mb-2" />

                <button class="btn btn-primary" onclick="updateFood()">
                    Cập nhật
                </button>

            </div>
        </div>
    </div>

    <script>
            const form = document.getElementById("foodForm");

            // ================= ADD =================
            form.addEventListener("submit", async function (e) {
                e.preventDefault();

                let formData = new FormData(this);

                let res = await fetch('/Admin/Food_Management', {
                    method: 'POST',
                    body: formData
                });

                let data = await res.json();

                if (data.success) {

                    let f = data.food;

                                let html = `
            <div class="col-md-4 mb-3" id="food-${f.food_ID}">
                <div class="card shadow-sm">

                    <img src="${f.image_URL ?? ''}" class="card-img-top" style="height:180px;object-fit:cover;" />

                    <div class="card-body">
                        <h5>${f.food_NAME}</h5>
                        <p class="desc">${f.description ?? ''}</p>
                        <p class="cook">⏱ ${f.cook_TIME} phút</p>
                    </div>

                    <div class="card-footer text-end">

                        <button class="btn btn-warning btn-sm"
                            onclick="openEdit(
                                ${f.food_ID},
                                '${(f.food_NAME ?? "").replace(/'/g, "\\'")}',
                                '${(f.description ?? "").replace(/'/g, "\\'")}',
                                ${f.cook_TIME},
                                ${f.category_ID}
                            )">
                            ✏ Sửa
                        </button>

                        <button class="btn btn-danger btn-sm"
                            onclick="deleteFood(${f.food_ID})">
                            🗑 Xoá
                        </button>

                    </div>

                </div>
            </div>`;

                    document.getElementById("foodList")
                        .insertAdjacentHTML("afterbegin", html);

                    form.reset();
                }
            });

            // ================= DELETE =================
            async function deleteFood(id) {

                if (!confirm("Bạn có chắc muốn xoá?")) return;

                let res = await fetch('/Admin/DeleteFood', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded'
                    },
                    body: 'id=' + id
                });

                let data = await res.json();

                if (data.success) {
                    document.getElementById("food-" + id).remove();
                }
            }

            // ================= UPDATE =================
            async function updateFood() {

                let formData = new FormData();

                formData.append("Food.FOOD_ID", document.getElementById("editId").value);
                formData.append("Food.FOOD_NAME", document.getElementById("editName").value);
                formData.append("Food.CATEGORY_ID", document.getElementById("editCategory").value);
                formData.append("Food.DESCRIPTION", document.getElementById("editDesc").value);
                formData.append("Food.COOK_TIME", document.getElementById("editCook").value);

                let img = document.getElementById("editImage");
                if (img.files.length > 0) {
                    formData.append("ImageFile", img.files[0]);
                }

                let res = await fetch('/Admin/UpdateFood', {
                    method: 'POST',
                    body: formData
                });

                let data = await res.json();

                if (data.success) {

                    let f = data.food;

                    // update UI
                    let card = document.getElementById("food-" + f.food_ID);

                    card.querySelector("h5").innerText = f.food_NAME;
                                card.querySelector(".desc").innerText = f.description;
            card.querySelector(".cook").innerText = "⏱ " + f.cook_TIME + " phút";

                    if (f.image_URL) {
                        card.querySelector("img").src = f.image_URL;
                    }

                    bootstrap.Modal.getInstance(
                        document.getElementById('editModal')
                    ).hide();
                }
            }

            function openEdit(id, name, desc, cook, category) {
                document.getElementById("editId").value = id;
                document.getElementById("editName").value = name;
                document.getElementById("editDesc").value = desc;
                document.getElementById("editCook").value = cook;
                document.getElementById("editCategory").value = category;

            new bootstrap.Modal(document.getElementById('editModal')).show();
            }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>