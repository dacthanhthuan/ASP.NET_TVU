@model LMS.ViewModels.FoodCreateViewModel

<div class="container mt-4">
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <h4>Thêm món ăn mới</h4>
        </div>

        <div class="card-body">
            <form asp-action="Create" method="post" enctype="multipart/form-data">

                <div class="mb-3">
                    <label class="form-label">Tên món ăn</label>
                    <input asp-for="Food.FOOD_NAME" class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Danh mục</label>
                    <select asp-for="Food.CATEGORY_ID" class="form-select">
                        @foreach (var item in Model.Categories)
                        {
                            <option value="@item.CATEGORY_ID">
                                @item.CATEGORY_NAME
                            </option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Mô tả</label>
                    <textarea asp-for="Food.DESCRIPTION"
                              class="form-control"
                              rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Hình ảnh</label>
                    <input type="file"
                           name="ImageFile"
                           class="form-control"
                           accept="image/*" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Độ khó nấu ăn</label>
                    <select asp-for="Food.COOK_TIME" class="form-select">
                        <option value="">-- Chọn độ khó --</option>
                        <option value="15">🟢 Siêu dễ (15 phút)</option>
                        <option value="30">🟡 Dễ (30 phút)</option>
                        <option value="45">🔴 Khó (45 phút)</option>
                    </select>
                </div>

                <button type="submit"
                        class="btn btn-success">
                    Lưu món ăn
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    Quay lại
                </a>

            </form>
        </div>
    </div>
</div>